/:lang/guest*
  X-Robots-Tag: noindex, nofollow, noarchive

/:lang/dashboard*
  X-Robots-Tag: noindex, nofollow, noarchive

/:lang/share/*
  X-Robots-Tag: noindex, nofollow, noarchive

/:lang/icons-showcase
